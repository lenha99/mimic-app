# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# ── 협업 추가 규칙 ──────────────────────────────
# 빌드 산출물 (APK/AAB는 절대 커밋 금지 — 50MB 넘음)
*.apk
*.aab
*.ipa
releases/
build/

# 로컬 전용 설정 (사람마다 다름)
.claude/settings.local.json
local.properties
android/key.properties
*.jks
*.keystore
.env
.env.*

# 데스크톱 플랫폼 (현재 미사용)
/macos/
/windows/
/linux/

# OS / 에디터
Thumbs.db
.vscode/*
!.vscode/settings.json

# 임시 산출물
*.zip
out/
tmp/

# 원본 유래 밈 클립 — 커밋하지 않는다.
# git 히스토리에 들어간 저작물은 파일을 지워도 안 없어지고, 히스토리 재작성은
# CONTRIBUTING 이 금지한다. content/registry.json 의 origin 으로 언제든 다시 만든다.
refs_kr/
