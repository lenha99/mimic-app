# 이 파일을 .env.local 로 복사해서 쓴다. 전부 선택 사항이고,
# 비워두면 lib/config.ts 의 기본값(현재 배포된 Modal 엔드포인트)을 쓴다.

# 웹앱 공개 주소. OG 카드가 절대 URL을 요구하므로 배포 후 실제 주소를 넣는다.
# Vercel 에서는 비워둬도 VERCEL_PROJECT_PRODUCTION_URL 로 자동 해결된다.
# NEXT_PUBLIC_SITE_URL=https://mimic.vercel.app

# --- 채점 서버 (Modal) ---------------------------------------------------
# NEXT_PUBLIC_SCORE_URL=https://lenha99--meme-scoring-score.modal.run
# NEXT_PUBLIC_VIDEO_URL=https://lenha99--meme-scoring-make-video.modal.run

# --- 카탈로그·기준음성 (Supabase 이전 예정, 이슈 #18) --------------------
# NEXT_PUBLIC_MEMES_URL=https://lenha99--meme-scoring-memes.modal.run
# NEXT_PUBLIC_REFERENCE_URL=https://lenha99--meme-scoring-reference.modal.run
